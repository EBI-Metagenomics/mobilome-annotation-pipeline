/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run ebi-metagenomics/mobilome-annotation-pipeline -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

profiles {
    test {
        process {
            errorStrategy = 'terminate'
            maxRetries = 0
            resourceLimits = [
                cpus: 8,
                memory: 15.GB,
                time: 1.h,
            ]
            withLabel: 'process_medium' {
                cpus = 2
            }
            // ISEScan (label process_high) is the test bottleneck on the large contig and
            // parallelises via --nthread ${task.cpus}; give process_high 8 CPUs here.
            // NB: do not add a `withName: ISESCAN` block — in this config it replaces the
            // modules.config ISESCAN selector and drops its publishDir.
            withLabel: 'process_high' {
                cpus = 8
            }
        }
        params {
            genomad_db                   = "${projectDir}/tests/reference_databases/genomad/nanogenomad_v19"
            icefinder_hmm_models         = "${projectDir}/tests/reference_databases/icefinder/icehmm/icescan.hmm"
            icefinder_macsyfinder_models = "${projectDir}/tests/reference_databases/icefinder/macsyfinder_tffscan_models"
            icefinder_prokka_uniprot_db  = "${projectDir}/tests/reference_databases/icefinder/prokka_uniprot_sprot/"
            rgi_db                       = "${projectDir}/tests/reference_databases/card"
            zenodo_id                    = "18223764"
            vfdb_url                     = "https://www.mgc.ac.cn/VFs/Down/VFDB_setB_pro.fas.gz"
        }
    }
}
