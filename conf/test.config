/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run ebi-metagenomics/mobilome-annotation-pipeline -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

profiles {
    test {
        process {
            errorStrategy = 'terminate'
            maxRetries = 0
            resourceLimits = [
                cpus: 4,
                memory: 15.GB,
                time: 1.h,
            ]
            withLabel: 'process_medium' {
                cpus = 4
            }
            withLabel: 'process_high' {
                cpus = 8
            }
        }
        params {
            genomad_db                   = "${projectDir}/tests/reference_databases/genomad/nanogenomad_v19"
            checkv_db                    = "${projectDir}/tests/reference_databases/checkv/checkv_minimal_db"
            // Full ICEfinder2-lite DBs, fetched on the fly (see `task fetch-icefinder-test-db`).
            // Replaces the old hand-curated AICE-only mini-DB, which could not detect the
            // T4SS/MOBH/typeG ICE in the positive test assembly.
            icefinder_hmm_models         = "${projectDir}/tests/reference_databases/icefinder/icf2_dbs/icehmm/icescan.hmm"
            icefinder_macsyfinder_models = "${projectDir}/tests/reference_databases/icefinder/icf2_dbs/macsydata"
            icefinder_prokka_uniprot_db  = "${projectDir}/tests/reference_databases/icefinder/icf2_dbs/icefinder_prokka_uniprot/"
            rgi_db                       = "${projectDir}/tests/reference_databases/card"
            zenodo_id                    = "18223764"
            vfdb_url                     = "https://www.mgc.ac.cn/VFs/Down/VFDB_setB_pro.fas.gz"
        }
    }
}
