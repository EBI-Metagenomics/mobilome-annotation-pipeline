/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Module options for the database download subworkflow (--download_dbs mode)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Included by nextflow.config ONLY when running with --download_dbs. Kept separate from
    conf/modules.config because the download subworkflow and the main pipeline are mutually
    exclusive run modes; loading each mode's selectors only when that mode runs avoids the
    "no process matching config selector" warnings while keeping selector-name validation on.
----------------------------------------------------------------------------------------
*/

process {

    withName: 'DOWNLOAD_DATABASES:DB_DOWNLOAD_MOBILOME_DBS' {
        // Single process emits two databases; route each into its own subdirectory.
        publishDir = [
            path: { params.download_dbs },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if ( filename.equals('versions.yml') ) {
                    return null
                } else if ( filename.startsWith('genomad_db_v1.9') ) {
                    return "genomad/${filename}"
                } else if ( filename.startsWith('icf2_dbs') ) {
                    return "icefinder2/${filename}"
                } else {
                    return filename
                }
            },
        ]
    }

    withName: 'DOWNLOAD_DATABASES:CHECKV_DOWNLOADDATABASE' {
        publishDir = [
            path: { "${params.download_dbs}/checkV" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: 'DOWNLOAD_DATABASES:DB_DOWNLOAD_VFDB' {
        publishDir = [
            path: { "${params.download_dbs}/virulence" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: 'DOWNLOAD_DATABASES:DB_UNTAR_AMRFINDERPLUS' {
        publishDir = [
            path: { "${params.download_dbs}/amrfinderplus" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: 'DOWNLOAD_DATABASES:DB_UNTAR_PATHOFACT' {
        // Publish the uncompressed Models/ rather than the Models.tar.gz tarball.
        publishDir = [
            path: { "${params.download_dbs}/pathofact" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: 'DOWNLOAD_DATABASES:DEEPARG_DOWNLOADDATA' {
        publishDir = [
            path: { "${params.download_dbs}/deeparg" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: 'DOWNLOAD_DATABASES:ANTISMASH_ANTISMASHDOWNLOADDATABASES' {
        publishDir = [
            path: { "${params.download_dbs}/antismash" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: 'DOWNLOAD_DATABASES:LOCALCDSEARCH_DOWNLOAD' {
        publishDir = [
            path: { "${params.download_dbs}/localcdsearch" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: 'DOWNLOAD_DATABASES:RGI_DOWNLOADDB' {
        publishDir = [
            path: { "${params.download_dbs}/rgi" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }
}
