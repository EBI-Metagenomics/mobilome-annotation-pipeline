/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/


process {

    withName: AMRFINDERPLUS_RUN {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/prediction/amr_genes/amrfinderplus" },
            mode: params.publish_dir_mode,
            enabled: params.publish_all,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: AMRINTEGRATOR {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/prediction/amr_genes" },
            mode: params.publish_dir_mode,
            enabled: params.publish_all,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: ANTISMASH_JSON2GFF {
        ext.args = "--cds_tag locus_tag"
        publishDir = [
            path: { "${params.outdir}/${meta.id}/prediction/bgcs/antismash" },
            mode: params.publish_dir_mode,
            enabled: params.publish_all,
            pattern: '*_antismash.gff',
        ]
    }

    withName: ARAGORN {
        ext.args = [
            "-l",
            "-w",
            "-gc1",
        ].join(' ')
    }

    withName: BGCSMAPPER {
        ext.args = "--validate_json"
        publishDir = [
            path: { "${params.outdir}/${meta.id}/prediction/bgcs" },
            mode: params.publish_dir_mode,
            enabled: params.publish_all
        ]
    }

    withName: BLASTP_PROKKA {
        ext.args   = [
            "-outfmt \"6 qseqid sseqid pident length mismatch gapopen qstart qend sstart send evalue bitscore qlen slen stitle\"",
            "-evalue", "1E-9",
            "-qcov_hsp_perc", "80",
            "-num_descriptions", "1",
            "-num_alignments", "1",
            "-seg", "no"
        ].join(' ')
        ext.prefix = { "${meta.id}_blastp_uniprot" }
    }

    withName: COMBINEREPORTER {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/" },
            mode: params.publish_dir_mode,
        ]
    }

    withName: DEEPARG_PREDICT {
        ext.args = '--type prot'
        publishDir = [
            path: { "${params.outdir}/${meta.id}/prediction/amr_genes/deeparg" },
            mode: params.publish_dir_mode,
            enabled: params.publish_all,
            pattern: '*.mapping.ARG',
        ]
    }

    withName: DIAMOND_BLASTP {
        ext.args = [
            "--max-target-seqs", "25",
            "--evalue", "1e-5",
            "--id", "30",
            "--query-cover", "60",
            "--subject-cover", "50",
        ].join(' ')
    }

    withName: FASTA_WRITER {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: GECCO_CONVERT {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/prediction/bgcs/gecco" },
            mode: params.publish_dir_mode,
            enabled: params.publish_all,
            pattern: '**/*.gff',
            saveAs: { filename -> filename.tokenize('/').last() },
        ]
    }

    withName: GENOMAD {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/prediction/genomad" },
            mode: params.publish_dir_mode,
            enabled: params.publish_all,
            pattern: "*_summary.tsv",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: CHECKV_ENDTOEND {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/prediction/genomad" },
            mode: params.publish_dir_mode,
            enabled: params.publish_all,
            pattern: "*/quality_summary.tsv",
            saveAs: { filename -> "checkv_quality_summary.tsv" },
        ]
    }

    withName: INTERPROSCAN {
        cpus   = 16
        memory = { 32.GB * task.attempt }
        ext.args = {
            def applications = [
                "CDD",
                "TIGRFAM",
                "GENE3D",
                "PRINTS",
                "PROSITEPATTERNS",
                "PFAM"
            ]
            if ( params.interpro_licensed_software ) {
                applications << "SIGNALP"
            }
            return "--applications " + applications.join(",")
        }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/prediction/interproscan" },
            mode: params.publish_dir_mode,
            enabled: params.publish_all,
            pattern: '*.tsv.gz',
        ]
    }

    withName: PATHOFACT2_INTEGRATOR {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/prediction/virulence" },
            mode: params.publish_dir_mode,
            enabled: params.publish_all
        ]
    }

    withName: PATHOFACT2_TOXINS {
        ext.args = [
            "-k", "5"
        ].join(' ')
    }

    withName: TABIX_BGZIP {
        // The input name needs to be kept, it contains the meta.id already
        ext.prefix = { input.baseName }
        ext.args = { "--index" }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/gff" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: TABIX_BGZIPTABIX {
        // The input name needs to be kept, it contains the meta.id already
        ext.prefix = { input.baseName }
        ext.args2 = { "--csi" }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/gff" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: INTEGRATOR {
        publishDir = [
            [
                path: { "${params.outdir}/${meta.id}/gff" },
                mode: params.publish_dir_mode,
                pattern: '*.gff.gz',
            ],
            [
                path: { "${params.outdir}/${meta.id}" },
                mode: params.publish_dir_mode,
                pattern: '*.txt'
            ]
        ]
    }

    withName: INTEGRONFINDER {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/prediction/integronfinder" },
            mode: params.publish_dir_mode,
            enabled: params.publish_all,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: ISESCAN {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/prediction/isescan" },
            mode: params.publish_dir_mode,
            enabled: params.publish_all,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: MACSYFINDER {
        ext.args = [
            "--coverage-profile",
            "0.3",
            "--replicon-topology",
            "linear",
            "--db-type",
            "ordered_replicon",
            "--hmmer",
            "hmmsearch",
            "--models",
            "ICEscan",
            "all",
        ].join(' ')
    }

    withName: OUTLIER_FINDER {
        memory     = { 24.GB * task.attempt }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/prediction/compositional_outliers" },
            mode: params.publish_dir_mode,
            enabled: params.publish_all,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: PRODIGAL {
        ext.args = [
            "-p",
            "meta",
        ].join(' ')
    }

    withName: REFINE_BOUNDARIES {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/prediction/icefinder2lite" },
            mode: params.publish_dir_mode,
            enabled: params.publish_all,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: RENAME {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/preprocessing" },
            mode: params.publish_dir_mode,
            enabled: params.publish_all,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: RGI_MAIN {
        // RGI rejects --num_threads > 2 (it passes task.cpus directly), so cap CPUs here.
        // withName outranks withLabel, so this holds across all profiles.
        cpus = 2
        ext.args2 = '--input_type protein'
        publishDir = [
            path: { "${params.outdir}/${meta.id}/prediction/amr_genes/rgi" },
            mode: params.publish_dir_mode,
            enabled: params.publish_all,
            pattern: '*.txt',
        ]
    }

    withName: SANNTIS {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/prediction/bgcs/sanntis" },
            mode: params.publish_dir_mode,
            enabled: params.publish_all,
            pattern: '*_sanntis.gff.gz',
        ]
    }

    withName: VIRIFY_QC {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/prediction/virify_filter" },
            mode: params.publish_dir_mode,
            enabled: params.publish_all,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: VMATCH {
        ext.args  = [
            "-dna",
            "-pl",
            "-lcp",
            "-suf",
            "-tis",
            "-ois",
            "-bwt",
            "-bck",
            "-sti1",
        ].join(' ')
        ext.args2 = [
            "-l",
            "15",
            "-showdesc",
            "0",
        ].join(' ')
    }

    // Pipeline info modules
    withName: CUSTOM_DUMPSOFTWAREVERSIONS {
        publishDir = [
            path: { "${params.outdir}/pipeline_info" },
            mode: params.publish_dir_mode,
            pattern: '*_versions.yml'
        ]
    }

    // -------------------------------------------------------------------------
    // Database download subworkflow (--download_dbs mode)
    // Scoped to DOWNLOAD_DATABASES context so existing uses are unaffected.
    // -------------------------------------------------------------------------

    withName: 'DOWNLOAD_DATABASES:DB_DOWNLOAD_MOBILOME_DBS' {
        // Single process emits two databases; route each into its own subdirectory.
        publishDir = [
            path: { params.download_dbs },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if ( filename.equals('versions.yml') ) {
                    return null
                } else if ( filename.startsWith('genomad_db_v1.9') ) {
                    return "genomad/${filename}"
                } else if ( filename.startsWith('icf2_dbs') ) {
                    return "icefinder2/${filename}"
                } else {
                    return filename
                }
            },
        ]
    }

    withName: 'DOWNLOAD_DATABASES:CHECKV_DOWNLOADDATABASE' {
        publishDir = [
            path: { "${params.download_dbs}/checkV" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: 'DOWNLOAD_DATABASES:DB_DOWNLOAD_VFDB' {
        publishDir = [
            path: { "${params.download_dbs}/virulence" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: 'DOWNLOAD_DATABASES:DB_UNTAR_AMRFINDERPLUS' {
        publishDir = [
            path: { "${params.download_dbs}/amrfinderplus" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: 'DOWNLOAD_DATABASES:DB_UNTAR_PATHOFACT' {
        // Publish the uncompressed Models/ rather than the Models.tar.gz tarball.
        publishDir = [
            path: { "${params.download_dbs}/pathofact" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: 'DOWNLOAD_DATABASES:DEEPARG_DOWNLOADDATA' {
        publishDir = [
            path: { "${params.download_dbs}/deeparg" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: 'DOWNLOAD_DATABASES:ANTISMASH_ANTISMASHDOWNLOADDATABASES' {
        publishDir = [
            path: { "${params.download_dbs}/antismash" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: 'DOWNLOAD_DATABASES:LOCALCDSEARCH_DOWNLOAD' {
        publishDir = [
            path: { "${params.download_dbs}/localcdsearch" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }

    withName: 'DOWNLOAD_DATABASES:RGI_DOWNLOADDB' {
        publishDir = [
            path: { "${params.download_dbs}/rgi" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
        ]
    }
}
