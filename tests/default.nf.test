nextflow_pipeline {

    name "Test mobilome annotation pipeline main.nf"
    script "../main.nf"
    tag "pipeline"

    test("Positive test: mobilome-only run on two-contig assembly covering IS, integron, ICE, prophage, and CO") {
        tag "positive"
        when {
            params {
                input                = "${projectDir}/tests/GCF_002192495_samplesheet.csv"
                outdir               = "$outputDir"
                skip_virulence       = true
                skip_amrfinderplus   = true
                skip_deeparg         = true
                skip_rgi             = true
                skip_sanntis         = true
                skip_gecco           = true
                skip_antismash       = true
            }
        }

        then {
            // stable_name: All files + folders in ${params.outdir}/ with a stable name
            def stable_name = getAllFilesFromDir(
                params.outdir,
                relative: true,
                includeDir: true,
                ignore: [
                    'pipeline_info/*'
                ]
            )
            // stable_path: All files in ${params.outdir}/ with stable content
            def stable_path = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            // {tbi,gzi}_files: Check .tbi and .gzi index files exist with stable names
            def index_files = getAllFilesFromDir(
                params.outdir,
                relative: true,
                include: ['*.tbi', '*.gzi']
            )
            assertAll(
                { assert workflow.success},
                { assert snapshot(
                    // Number of tasks
                    workflow.trace.succeeded().size(),
                    // All stable path name
                    stable_name,
                    // All files with stable contents
                    stable_path,
                    // .gzi and .tbi index files (stable names only)
                    index_files,
                ).match() }
            )
        }
    }

    test("Negative test of the mobile elements detection skipping pathofact annotation. Expect empty gff output file") {
        tag "negative"
        when {
            params {
                input              = "${projectDir}/tests/neg_test_samplesheet.csv"
                outdir             = "$outputDir"
                skip_virulence     = true
                skip_amrfinderplus = true
                skip_deeparg       = true
                skip_rgi           = true
                skip_sanntis       = true
                skip_gecco         = true
                skip_antismash     = true
            }
        }

        then {
            // stable_name: All files + folders in ${params.outdir}/ with a stable name
            def stable_name = getAllFilesFromDir(
                params.outdir,
                relative: true,
                includeDir: true,
                ignore: [
                    'pipeline_info/*'
                ]
            )
            // stable_path: All files in ${params.outdir}/ with stable content
            def stable_path = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            assertAll(
                { assert workflow.success},
                { assert snapshot(
                    // Number of tasks
                    workflow.trace.succeeded().size(),
                    // All stable path name
                    stable_name,
                    // All files with stable contents
                    stable_path,
                ).match() }
            )
        }
    }

    test("Schema validation: proteins_gff without proteins_faa should fail (dependentRequired)") {
        tag "schema"
        when {
            params {
                input  = "${projectDir}/tests/invalid_proteins_samplesheet.csv"
                outdir = "$outputDir"
            }
        }

        then {
            assert workflow.failed
            // workflow.stderr is a list of lines; check the substring per line
            assert workflow.stderr.any { it.contains("proteins_faa") }
        }
    }

    test("Pathofact integration test with annotation manifest. Expected a report of proteins with relevant annotation") {
        tag "pathofact"
        when {
            params {
                input                = "${projectDir}/tests/pathofact_samplesheet.csv"
                outdir               = "$outputDir"
                annotation_manifest  = "${projectDir}/tests/data/MGYG000528118_sub/annotation_manifest.csv"
                skip_deeparg         = true    // skipping as minidatabase building is not possible. Test at subwf level 
            }
        }

        then {
            // stable_name: All files + folders in ${params.outdir}/ with a stable name
            def stable_name = getAllFilesFromDir(
                params.outdir,
                relative: true,
                includeDir: true,
                ignore: [
                    'pipeline_info/*'
                ]
            )
            // stable_path: All files in ${params.outdir}/ with stable content
            def stable_path = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            assertAll(
                { assert workflow.success},
                { assert snapshot(
                    // Number of tasks
                    workflow.trace.succeeded().size(),
                    // All stable path name
                    stable_name,
                    // All files with stable contents
                    stable_path,
                ).match() }
            )
        }
    }
}
