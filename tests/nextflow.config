/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running nf-test tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

    Use as follows:
        nextflow run ebi-metagenomics/mobilome-annotation-pipeline -profile test

----------------------------------------------------------------------------------------
*/

// Optionally include a site-specific infra config for local debugging (e.g. CODON/SLURM).
// Set NXF_EXTRA_CONFIG=/path/to/base.config before running nf-test.
if (System.getenv("NXF_EXTRA_CONFIG")) {
    includeConfig System.getenv("NXF_EXTRA_CONFIG")
}

// Optionally include a site-specific database params config (e.g. for pathofact/AMR/BGC tests).
// Set NXF_TEST_DB_CONFIG=/path/to/db_params.config before running nf-test.
if (System.getenv("NXF_TEST_DB_CONFIG")) {
    includeConfig System.getenv("NXF_TEST_DB_CONFIG")
}
